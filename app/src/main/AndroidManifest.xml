<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 添加网络权限 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- 添加网络状态权限 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    
    <application
        android:allowBackup="true"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:targetApi="28">

        <!-- 保留 LoginActivity 作为启动 Activity -->
        <activity
            android:name=".LoginActivity"
            android:label="登录"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HomeActivity 及其他 Activity 定义保持不变 -->
        <activity
            android:name=".HomeActivity"
            android:label="首页"
            android:exported="false" />

        <!-- SettingsActivity -->
        <activity
            android:name=".SettingsActivity"
            android:label="设置"
            android:exported="false" />

        <!-- AboutActivity -->
        <activity
            android:name=".AboutActivity"
            android:label="关于"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:label="个人信息"
            android:exported="false" />

        <!-- 添加报警信息页面 -->
        <!-- 报警通知的Activity -->
        <activity
            android:name=".AlertsActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:label="报警信息">
        </activity>

        <!-- 添加通知元数据 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />


        <activity
            android:name=".TasksActivity"
            android:label="任务信息"
            android:exported="false" />

        <activity
            android:name=".RecordsActivity"
            android:label="异常记录"
            android:exported="false" />

        <activity
            android:name=".RecordDetailActivity"
            android:label="异常记录"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".QrScannerActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AppTheme.FullScreen"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name=".PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:exported="false" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.pzy.smart_manufacture_app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>



    </application>
</manifest>